{
  "name": "camera-hal-sw-newsletter",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini newsroom 자동화로 운영하는 정적 Camera HAL SW 뉴스레터 사이트.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node src/shared/cli/collect-news-candidates.js",
    "doctor:config": "node src/shared/tooling/cli/doctor-config.js",
    "generate": "node src/generator/publish/gemini-newsroom-newsletter.js",
    "ci": "npm run test && npm run validate",
    "report:source-effectiveness": "node src/generator/publish/build-source-effectiveness-report.js",
    "report:source-quality-diagnosis": "node src/generator/publish/build-source-quality-diagnosis.js",
    "report:evidence-pack": "node src/generator/publish/build-evidence-pack-summary.js",
    "report:hal-signal-quality": "node src/generator/publish/build-hal-signal-quality-report.js",
    "report:hal-signal-scorecard": "node src/shared/tooling/cli/build-hal-signal-quality-scorecard.js",
    "report:cleanup-candidates": "node src/shared/tooling/cli/report-cleanup-candidates.js",
    "newsroom:audit-images": "node src/generator/publish/audit-newsletter-images.js",
    "newsroom:repair-images": "node src/generator/publish/repair-newsletter-images.js",
    "audit:historical-newsletters": "node src/generator/publish/audit-historical-newsletters.js",
    "sync:policy-docs": "node src/shared/tooling/cli/sync-policy-docs.js",
    "generate:sitemap": "node src/generator/render/generate-sitemap.js",
    "test": "npm run test:unit && npm run test:script",
    "test:unit": "node src/shared/tooling/cli/run-node-tests.js src",
    "test:source-effectiveness": "node --test src/generator/test/workflow/source-effectiveness-report.test.js",
    "test:script": "node src/shared/tooling/cli/test-artifact-manifest.js && node src/shared/tooling/cli/test-selection-diagnostics.js",
    "test:artifact": "node src/shared/tooling/cli/test-artifact-manifest.js",
    "test:selection-diagnostics": "node src/shared/tooling/cli/test-selection-diagnostics.js",
    "check:fixtures": "node --test src/generator/test/contract/fixture-policy.test.js",
    "check:domain-model-boundary": "node src/shared/tooling/check-domain-model-boundary.js",
    "check:circular-dependencies": "node src/shared/tooling/check-circular-dependencies.js",
    "check:layer-direction": "node src/shared/tooling/check-layer-direction.js",
    "check:editor-schema-acceptance": "node src/shared/tooling/cli/check-editor-schema-acceptance.js",
    "check:encoding": "node src/shared/tooling/check-text-encoding.js",
    "check:repo-hygiene": "node src/shared/tooling/check-repo-hygiene.js",
    "check:artifact-retention": "node src/shared/tooling/cli/check-artifact-retention.js",
    "check:artifact-path-convention": "node src/shared/tooling/cli/check-artifact-path-convention.js",
    "validate": "npm run check:encoding && npm run check:repo-hygiene && npm run check:artifact-retention && npm run check:artifact-path-convention && npm run check:fixtures && npm run check:domain-model-boundary && npm run check:circular-dependencies && npm run check:layer-direction && npm run validate:policy && npm run check:policy-docs && npm run validate:config && npm run validate:site && npm run validate:archive && npm run validate:public && npm run validate:images && npm run validate:quality && npm run validate:localization && npm run validate:seo && npm run validate:url-parity",
    "validate:post-generation": "npm run check:encoding && npm run check:repo-hygiene && npm run check:fixtures && npm run check:domain-model-boundary && npm run check:circular-dependencies && npm run check:layer-direction && npm run validate:policy && npm run check:policy-docs && npm run validate:config && npm run validate:site && npm run validate:archive && npm run validate:public && npm run validate:images && npm run validate:llm-publication-quality && npm run validate:localization && npm run validate:seo && npm run validate:url-parity",
    "validate:policy": "node src/shared/tooling/cli/validate-newsletter-policy.js",
    "validate:archive": "node src/generator/validate/validate-archive.js",
    "validate:source-quality-rollout": "node src/shared/tooling/validate/validate-source-quality-rollout-exit.js",
    "check:policy-docs": "node src/shared/tooling/cli/sync-policy-docs.js --check",
    "validate:config": "node src/shared/tooling/cli/validate-config.js && node src/shared/tooling/cli/validate-newsroom-budget.js",
    "validate:site": "node src/generator/validate/validate-site.js",
    "validate:public": "node src/generator/validate/validate-public-newsletter.js",
    "validate:images": "node src/generator/validate/validate-external-images.js",
    "validate:quality": "node src/generator/validate/validate-quality.js",
    "validate:llm-publication-quality": "node src/generator/validate/validate-llm-publication-quality.js",
    "validate:localization": "node src/generator/validate/validate-localization.js",
    "validate:seo": "node src/generator/validate/validate-seo-metadata.js",
    "validate:url-parity": "node src/generator/validate/validate-url-parity.js",
    "dump:candidate-diagnostics": "node src/generator/publish/dump-candidate-diagnostics.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0"
  }
}
