{
  "name": "camera-hal-sw-newsletter",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini newsroom 자동화로 운영하는 정적 Camera HAL SW 뉴스레터 사이트.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect-news-candidates.js",
    "doctor:config": "node scripts/doctor-config.js",
    "generate": "node scripts/gemini-newsroom-newsletter.js",
    "ci": "npm run test && npm run validate",
    "report:source-effectiveness": "node scripts/build-source-effectiveness-report.js",
    "report:source-quality-diagnosis": "node scripts/build-source-quality-diagnosis.js",
    "report:evidence-pack": "node scripts/build-evidence-pack-summary.js",
    "report:hal-signal-quality": "node scripts/build-hal-signal-quality-report.js",
    "report:hal-signal-scorecard": "node scripts/build-hal-signal-quality-scorecard.js",
    "report:cleanup-candidates": "node scripts/newsroom/cli/report-cleanup-candidates.js",
    "newsroom:audit-images": "node scripts/audit-newsletter-images.js",
    "newsroom:repair-images": "node scripts/repair-newsletter-images.js",
    "audit:historical-newsletters": "node scripts/audit-historical-newsletters.js",
    "sync:policy-docs": "node scripts/sync-policy-docs.js",
    "test": "npm run test:unit && npm run test:script",
    "test:unit": "node scripts/run-node-tests.js tests",
    "test:source-effectiveness": "node --test tests/workflow/source-effectiveness-report.test.js",
    "test:script": "node scripts/test-artifact-manifest.js && node scripts/test-selection-diagnostics.js",
    "test:artifact": "node scripts/test-artifact-manifest.js",
    "test:selection-diagnostics": "node scripts/test-selection-diagnostics.js",
    "check:fixtures": "node --test tests/contract/fixture-policy.test.js",
    "check:domain-model-boundary": "node scripts/check-domain-model-boundary.js",
    "check:encoding": "node scripts/check-text-encoding.js",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.js",
    "check:artifact-retention": "node scripts/check-artifact-retention.js",
    "validate": "npm run check:encoding && npm run check:repo-hygiene && npm run check:artifact-retention && npm run check:fixtures && npm run check:domain-model-boundary && npm run validate:policy && npm run check:policy-docs && npm run validate:config && npm run validate:site && npm run validate:archive && npm run validate:public && npm run validate:images && npm run validate:quality && npm run validate:localization",
    "validate:post-generation": "npm run check:encoding && npm run check:repo-hygiene && npm run check:fixtures && npm run check:domain-model-boundary && npm run validate:policy && npm run check:policy-docs && npm run validate:config && npm run validate:site && npm run validate:archive && npm run validate:public && npm run validate:images && npm run validate:llm-publication-quality && npm run validate:localization",
    "validate:policy": "node scripts/validate-newsletter-policy.js",
    "validate:archive": "node scripts/validate-archive.js",
    "validate:source-quality-rollout": "node scripts/newsroom/validate/validate-source-quality-rollout-exit.js",
    "check:policy-docs": "node scripts/sync-policy-docs.js --check",
    "validate:config": "node scripts/validate-config.js && node scripts/validate-newsroom-budget.js",
    "validate:site": "node scripts/validate-site.js",
    "validate:public": "node scripts/validate-public-newsletter.js",
    "validate:images": "node scripts/validate-external-images.js",
    "validate:quality": "node scripts/validate-quality.js",
    "validate:llm-publication-quality": "node scripts/validate-llm-publication-quality.js",
    "validate:localization": "node scripts/validate-localization.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0"
  }
}
