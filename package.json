{
  "name": "camera-hal-sw-newsletter",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini newsroom 자동화로 운영하는 정적 Camera HAL SW 뉴스레터 사이트.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect-news-candidates.js",
    "doctor:config": "node scripts/doctor-config.js",
    "generate": "node scripts/gemini-newsroom-newsletter.js",
    "ci": "npm run test && npm run validate",
    "report:source-effectiveness": "node scripts/build-source-effectiveness-report.js",
    "sync:policy-docs": "node scripts/sync-policy-docs.js",
    "test": "npm run test:unit && npm run test:script",
    "test:unit": "node --test \"tests/**/*.test.js\"",
    "test:source-effectiveness": "node --test tests/source-effectiveness-report.test.js",
    "test:script": "node scripts/test-artifact-manifest.js && node scripts/test-selection-diagnostics.js",
    "test:artifact": "node scripts/test-artifact-manifest.js",
    "test:selection-diagnostics": "node scripts/test-selection-diagnostics.js",
    "check:encoding": "node scripts/check-text-encoding.js",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.js",
    "validate": "npm run check:encoding && npm run check:repo-hygiene && npm run validate:policy && npm run check:policy-docs && npm run validate:config && npm run validate:site && npm run validate:images && npm run validate:quality && npm run validate:localization",
    "validate:policy": "node scripts/validate-newsletter-policy.js",
    "check:policy-docs": "node scripts/sync-policy-docs.js --check",
    "validate:config": "node scripts/validate-config.js",
    "validate:site": "node scripts/validate-site.js",
    "validate:images": "node scripts/validate-external-images.js",
    "validate:quality": "node scripts/validate-quality.js",
    "validate:localization": "node scripts/validate-localization.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0"
  }
}
